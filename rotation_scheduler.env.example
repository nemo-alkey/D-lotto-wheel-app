# SMTP credentials for rotation_scheduler.py email alerts
# Copy this file to rotation_scheduler.env and fill in your details.
# Then source it before running the script, or use EnvironmentFile= in systemd.

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=you@gmail.com
