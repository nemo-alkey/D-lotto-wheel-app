[Unit]
Description=NZ Lotto Powerball Rotation Plan Generator
Documentation=https://github.com/racing_dev/lotto-wheel-app

# ─── CUSTOMISE BEFORE USE ─────────────────────────────────────────────
# Set SMTP_PASSWORD to your email credentials.
#    For ProtonMail: install ProtonMail Bridge, use its local SMTP:
#       SMTP_SERVER=127.0.0.1  SMTP_PORT=1025
#       Password = Bridge mailbox password (not your ProtonMail login).
#    For Gmail: enable 2FA and generate an App Password.
#       https://myaccount.google.com/apppasswords
# ───────────────────────────────────────────────────────────────────────

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /media/racing_dev/FBC2-0CF4/lotto-wheel-app/rotation_scheduler.py --send-email --to RAlker@protonmail.com
WorkingDirectory=/media/racing_dev/FBC2-0CF4/lotto-wheel-app
Environment=SMTP_SERVER=127.0.0.1
Environment=SMTP_PORT=1025
Environment=SMTP_USERNAME=RAlker@protonmail.com
Environment=SMTP_PASSWORD=your-bridge-mailbox-password
StandardOutput=append:/media/racing_dev/FBC2-0CF4/lotto-wheel-app/rotation_scheduler.log
StandardError=append:/media/racing_dev/FBC2-0CF4/lotto-wheel-app/rotation_scheduler.log
