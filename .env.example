# ============================================================================
# NZ Lotto Wheel Analysis — Environment Variables (.env.example)
# ============================================================================
# Copy this file to .env and fill in your values:
#     cp .env.example .env        # Linux/macOS
#     copy .env.example .env      # Windows
#
# Canonical app config is config/settings.py (UPPERCASE, case-sensitive).
# Legacy names (JWT_SECRET_KEY, SMTP_SERVER, SMTP_USERNAME, SMTP_PASSWORD)
# are still accepted as aliases.
#
# IMPORTANT: when ENVIRONMENT=production the .env file is IGNORED — every
# value must be injected as a real environment variable by your platform
# (Docker secrets, systemd EnvironmentFile, k8s Secret, …), never a file.
# ============================================================================

# ============================================================================
# [App]
# ============================================================================
# Deployment tier: development | staging | production.
# production disables .env loading and enforces strict startup validation.
ENVIRONMENT=development

# Recognizable placeholder — MUST be replaced. Minimum 32 characters.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your-super-secret-key-here-min-32-chars

# true = dev mode (auto-reload, verbose errors). MUST be false in production.
DEBUG=false

# API bind address/port.
# API_HOST=0.0.0.0
# API_PORT=8000

# Comma-separated allowed CORS origins (never "*" in production).
# CORS_ORIGINS=https://app.example.com,https://www.example.com

# Feature flags — enable/disable whole modules without code changes.
# FEATURE_ML_PREDICTIONS=true    # ML-based number prediction endpoints
# FEATURE_BACKTESTING=true       # Historical wheel backtesting endpoints
# FEATURE_WEBSOCKETS=true        # Realtime draw-event WebSocket feed
# FEATURE_PAYMENTS=false         # Stripe payment flows (requires [Stripe])
# FEATURE_EMAIL_ALERTS=true      # Email alerts (requires [Email])

# ============================================================================
# [Database]
# ============================================================================
# SQLite (default, zero-setup local dev):
DATABASE_URL=sqlite:///data/lotto.db
# PostgreSQL (production — connection pooling is configured automatically):
# DATABASE_URL=postgresql://user:pass@localhost:5432/lotto

# Connection pool tuning (PostgreSQL only; ignored for SQLite).
# DB_POOL_SIZE=5          # persistent pooled connections
# DB_MAX_OVERFLOW=10      # extra connections allowed under load
# DB_POOL_TIMEOUT=30      # seconds to wait for a free connection
# DB_POOL_RECYCLE=1800    # recycle connections older than this (seconds)

# ============================================================================
# [Redis]
# ============================================================================
# Used for caching and distributed rate limiting. When unset the app falls
# back to in-process memory (fine for a single worker, not for scaling out).
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# [Email]
# ============================================================================
# SMTP settings for email alerts (requires FEATURE_EMAIL_ALERTS=true).
SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# Slack/Discord incoming webhook for ops alerts (optional).
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# ============================================================================
# [Stripe]
# ============================================================================
# Payment keys (only needed when FEATURE_PAYMENTS=true). Set all three
# together; a partial set triggers a startup warning.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================================================
# [Security]
# ============================================================================
# JWT token lifetimes / algorithm (consumed by auth.py).
# JWT_EXPIRE_MINUTES=15             # Access token lifetime (minutes)
# JWT_REFRESH_EXPIRE_DAYS=7         # Refresh token lifetime (days)
# JWT_ALGORITHM=HS256

# Shared secret for the internal new-draw hook (POST /internal/new-draw).
# INTERNAL_NOTIFY_TOKEN=

# Initial admin account created on first run — change immediately.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin

# Rate limiting (FastAPI / slowapi).
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS=60
# RATE_LIMIT_WINDOW=60
# API_RATE_LIMIT=60/minute
# HEAVY_RATE_LIMIT=5/minute

# ============================================================================
# Legacy / domain tuning (root settings.py — unchanged by this config)
# ============================================================================

# --- Monitoring ---
# LOTTO_API_URL=http://localhost:8000   # Dashboard "System Health" page
# PROMETHEUS_URL=http://localhost:9090  # Enables the 24h error-rate chart

# --- Database Backups (database_backup.py) ---
# BACKUP_ENABLED=true
# BACKUP_DIR=backups                # Backup destination directory
# BACKUP_RETENTION_DAYS=30          # Delete backups older than this
# BACKUP_COMPRESS_AFTER_DAYS=7      # Gzip backups older than this
# BACKUP_SCHEDULE=02:00             # Daily backup time (HH:MM, local)
# BACKUP_S3_BUCKET=                 # Optional off-site copy (needs AWS creds)
# BACKUP_AZURE_CONTAINER=           # Optional off-site copy (needs
                                    # AZURE_STORAGE_CONNECTION_STRING)

# --- Prize Pool & Allocation ---
# PRIZE_POOL_RATIO=0.75               # Fraction of turnover → prize pool
# RESERVE_LOTTO=0.25                  # Reserve fraction for Lotto
# RESERVE_POWERBALL=0.25              # Reserve fraction for Powerball
# DIV1_CAP=50000000                   # $50M maximum per Div 1 winner
# MAX_CONSECUTIVE_JACKPOTS=10         # Max Div 1 rollovers before must-win
# DIV7_PB_PRIZE=15.0                  # Fixed Div 7 Powerball prize (NZD)
# DIV7_LOTTO_PRIZE=2.80               # Fixed Div 7 Lotto prize (NZD)
# DEFAULT_LOTTO_POOL=215000           # Fallback Lotto pool estimate
# DEFAULT_POWERBALL_TURNOVER=2500000  # Fallback Powerball turnover estimate

# --- Selenium / ChromeDriver ---
# SELENIUM_CHROME_BINARY=/usr/bin/google-chrome   # Full path to Chrome binary
# USE_SELENIUM_FALLBACK=false

# --- Paths (relative to the project root, or absolute) ---
# DB_PATH=lotto.db
# PRIZE_CACHE_FILE=prize_cache.json
# ALERT_LOG=alert.log

# --- External API ---
# API_BASE=https://pathway.mylotto.co.nz
# API_TIMEOUT=15
# POLITE_DELAY=2.0
# CACHE_TTL_DAYS=7

# --- Misc ---
# DRAWS_PER_WEEK=2
# TICKET_COST=1.50
